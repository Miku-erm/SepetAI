generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model Product {
  id          String @id
  brand       String
  model       String
  category    String @default("laptop")
  price       Int
  stock       Int
  cpu         String
  gpu         String
  ramGb       Int
  storageGb   Int
  screenSize  Float
  refreshRate Int
  weightKg    Float
  batteryHours Int
  purposeTags String
  description String
  color       String
  cartItems   CartItem[]
}
model CartItem {
  id        Int @id @default(autoincrement())
  userId    String @default("demo")
  productId String
  quantity  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
}
